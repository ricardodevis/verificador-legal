# Credenciales Anthropic — copiar a .env y rellenar
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_WORKSPACE_ID=wks_xxx

# Configuración del proyecto
PROJECT_NAME=verificador-juris-bilbao
COORDINATOR_MAX_ITERATIONS=3

# Modelos base (referencia, no se usan directamente)
DEFAULT_MODEL_OPUS=claude-opus-4-7
DEFAULT_MODEL_SONNET=claude-sonnet-4-6
DEFAULT_MODEL_HAIKU=claude-haiku-4-5-20251001

# Modelos por agente
# A partir de v1.0.3: estrategia mixta. Coordinador y doctrina bajan a
# Sonnet 4.6 (antes Opus 4.7). Para rollback, basta con sobrescribir aquí.
# Análisis: docs/analisis-modelos.md
COORDINATOR_MODEL=claude-sonnet-4-6
DOCTRINA_MODEL=claude-sonnet-4-6
CENDOJ_MODEL=claude-sonnet-4-6
TC_MODEL=claude-sonnet-4-6
EURLEX_MODEL=claude-sonnet-4-6
BOE_MODEL=claude-haiku-4-5-20251001
